{
  "name": "aero-trips-passport-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=lib/index.js --external:firebase-functions --external:firebase-admin --external:@resvg/resvg-js --log-level=warning",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.2"
  }
}
