{
  "name": "aero-trips-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": { "node": "24" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=lib/index.js --loader:.json=json --external:firebase-functions --external:@modelcontextprotocol/sdk --external:zod --log-level=warning",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.2"
  }
}
