rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  	match /profiles/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    // Public pilot passports: written only by the `passports` Cloud Function
    // (Admin SDK bypasses these rules), readable by anyone.
    match /passports/{userId} {
      allow read: if true;
    }
    match /trips/{document} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /activities/{document} {
      allow write: if request.auth != null;
    }
    match /events/{document} {
      allow write: if request.auth != null;
    }
    match /airfields/{document} {
      allow update: if request.auth != null;
    }
    match /{collection}/{document=**} {
    	allow read: if collection in ['trips','activities', 'airfields', 'events'];
      allow create: if collection == 'changes';
    }
  }
}
